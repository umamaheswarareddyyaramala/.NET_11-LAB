@model List<SmartCampusPortal.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<h2>Smart Campus Service Portal</h2>

<div class="row mb-3">
    <div class="col"><div class="card p-2 text-center">Total<br /><b>@ViewBag.Total</b></div></div>
    <div class="col"><div class="card p-2 text-center">Pending<br /><b>@ViewBag.Pending</b></div></div>
    <div class="col"><div class="card p-2 text-center">In Progress<br /><b>@ViewBag.InProgress</b></div></div>
    <div class="col"><div class="card p-2 text-center">Resolved<br /><b>@ViewBag.Resolved</b></div></div>
</div>

<a asp-action="Create" class="btn btn-primary mb-3">New Request</a>
<a asp-action="Index" class="btn btn-outline-secondary mb-3">All</a>
<a asp-action="Index" asp-route-status="Pending" class="btn btn-outline-secondary mb-3">Pending</a>
<a asp-action="Index" asp-route-status="In Progress" class="btn btn-outline-secondary mb-3">In Progress</a>
<a asp-action="Index" asp-route-status="Resolved" class="btn btn-outline-secondary mb-3">Resolved</a>

<table class="table table-striped">
    <thead>
        <tr><th>ID</th><th>Student</th><th>Category</th><th>Description</th><th>Status</th><th>Date</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.StudentName</td>
                <td>@r.Category</td>
                <td>@r.Description</td>
                <td>@r.Status</td>
                <td>@r.CreatedDate.ToString("dd-MM-yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-warning">Update</a>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this request?');">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>